          <tr><td>2022 期中</td><td>萬灼華</td><td>同考古 10 題</td><td>學長姐作答</td><td><a href="#section-wan">第 6 節</a></td></tr>
          <tr><td>100-1 期末（principles of radiology / neural system）</td><td>張雅珮（推測）</td><td>單選 3、問答 1</td><td>考卷筆跡</td><td><a href="#section-cymc">第 3 節</a></td></tr>
